board = [" "] * 9
winning_lines = [
    (0, 1, 2), (3, 4, 5), (6, 7, 8),
    (0, 3, 6), (1, 4, 7), (2, 5, 8),
    (0, 4, 8), (2, 4, 6),
]

def show_board():
    print()
    for row in range(3):
        cells = board[row * 3:row * 3 + 3]
        print(" " + " | ".join(cell if cell != " " else str(row * 3 + i + 1)
                                for i, cell in enumerate(cells)))
        if row < 2:
            print("---+---+---")
    print()

def has_won(player):
    return any(all(board[i] == player for i in line) for line in winning_lines)

player = "X"

while True:
    show_board()
    choice = input(f"Player {player}, choose a square (1–9): ")

    if not choice.isdigit() or not 1 <= int(choice) <= 9:
        print("Please enter a number from 1 to 9.")
        continue

    position = int(choice) - 1
    if board[position] != " ":
        print("That square is already taken. Try another.")
        continue

    board[position] = player

    if has_won(player):
        show_board()
        print(f"Player {player} wins!")
        break

    if " " not in board:
        show_board()
        print("It's a draw!")
        break

    player = "O" if player == "X" else "X"
